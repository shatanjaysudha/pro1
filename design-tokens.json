{
  "typography": {
    "font_primary": "IBM Plex Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "base_size": "17px",
    "line_height": 1.7,
    "h1": {
      "size": "40px",
      "weight": 600,
      "line_height": 1.15
    },
    "h2": {
      "size": "32px",
      "weight": 600
    },
    "h3": {
      "size": "22px",
      "weight": 600
    }
  },
  "layout": {
    "container_max": "1100px",
    "gutter": "24px",
    "section_gap_small": "32px",
    "section_gap_medium": "48px",
    "section_gap_large": "80px",
    "text_column_min": "650px",
    "text_column_max": "720px",
    "sidebar_width": "280px",
    "split_left_column": "350px"
  },
  "motion": {
    "--motion-fast": "120ms",
    "--motion-medium": "220ms",
    "--motion-slow": "360ms",
    "--easing": "cubic-bezier(.2,.9,.25,1)"
  },
  "color": {
    "dark": {
      "bg": "#0b0b0f",
      "surface": "#131217",
      "card": "#1e1c20",
      "border": "#2a2730",
      "text": "#e8e7ea",
      "muted": "#9a95a0",
      "accent": "#F28A2B",
      "focus": "rgba(210,180,50,0.12)"
    },
    "light": {
      "bg": "#f4f5f7",
      "surface": "#ffffff",
      "card": "#f8f8fa",
      "border": "#d9dce3",
      "text": "#101216",
      "muted": "#606774",
      "accent": "#D97706",
      "focus": "rgba(179,138,49,0.2)"
    }
  },
  "radius": {
    "sm": "8px",
    "card": "12px"
  },
  "shadow": {
    "card_dark": "0 6px 20px rgba(0,0,0,0.5)",
    "hero_subtle": "0 10px 30px rgba(0,0,0,0.06)",
    "subtle_top": "0 -6px 20px rgba(0,0,0,0.35)"
  }
}
